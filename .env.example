# MONGODB_URI: MongoDB Atlas connection string for persistent database storage.
# When omitted in local development preview, the server falls back to local disk persistence (.data/).
MONGODB_URI=

# JWT_SECRET: Secret key used to sign authentication tokens in production.
# Leave blank in development to use an auto-generated runtime secret, or set a strong 64-char secret in production.
JWT_SECRET=

# PORT: Server port (must be 3000 in AI Studio).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional external backend API base URL (e.g. https://api.mshcompany.onrender.com).
# Leave empty when frontend and backend are served from the same origin.
VITE_API_BASE_URL=
